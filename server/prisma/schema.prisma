generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local: file:./dev.db (see server/prisma/.env). Railway: file:/data/foam.db on a volume.
  url      = env("DATABASE_URL")
}

model Foam {
  id               Int                    @id @default(autoincrement())
  grade            String                 @unique
  density          Float
  ild              Float?
  costPerBoardFoot Float
  supplier         String?
  description      String?
  // Odoo link: product.template / product.product of the raw foam (UoM = BF)
  odooTemplateId   Int?                   @unique
  odooProductId    Int?
  thicknessIn      Float?                 // slab thickness parsed from the Odoo name (5" Foam → 5)
  sheetLengthIn    Float                  @default(82) // stock slab size the cut optimizer packs onto
  sheetWidthIn     Float                  @default(36)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  customerPricing  CustomerFoamPricing[]
  inventory        FoamInventory?
  quotes           CushionQuote[]
  pieces           FoamPiece[]
}

model Dacron {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  weightOz        Float
  thicknessInches Float
  costPerSqFt     Float
  supplier        String?
  description     String?
  odooTemplateId  Int?             @unique
  odooProductId   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventory       DacronInventory?
  quotes          CushionQuote[]
  pieces          FoamPiece[]
}

// ============================================================
// Odoo-synced manufactured SKUs and their foam patterns (the foam BOM)
// ============================================================

model Sku {
  id             Int         @id @default(autoincrement())
  odooTemplateId Int         @unique
  code           String      // model code, e.g. 400-30 or L400-30
  name           String      // full Odoo name
  shortName      String      @default("")
  collection     String      @default("")
  active         Boolean     @default(true)
  odooBomId      Int?
  odooFoamLines  Json?       // [{lineId, productId, templateId, name, qty, uom}] as last synced
  wastePct       Float?      // override of the global waste allowance
  notes          String?
  lastSyncedAt   DateTime?
  pushedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pieces         FoamPiece[]

  @@index([code])
  @@index([collection])
}

model FoamPiece {
  id         Int      @id @default(autoincrement())
  skuId      Int
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  name       String   // Seat core, Back core, Arm pad, Deck pad…
  foamId     Int?
  foam       Foam?    @relation(fields: [foamId], references: [id])
  lengthIn   Float
  widthIn    Float
  heightIn   Float    // thickness
  qty        Int      @default(1)
  dacronId   Int?
  dacron     Dacron?  @relation(fields: [dacronId], references: [id])
  wrapDacron Boolean  @default(false)
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([skuId])
}

// A production run's foam requirement: from Odoo MOs or typed SKU × qty.
model FoamOrder {
  id           Int      @id @default(autoincrement())
  name         String
  status       String   @default("draft") // draft | optimized | ordered | cut | done
  source       String   @default("manual") // manual | mo
  lines        Json     // [{skuId, code, name, qty, moName?, moId?}]
  requirements Json?    // per foam: pieces, boardFeet, withWaste, onHand, shortfall
  cutPlan      Json?    // per foam: sheets[] with placed rectangles
  odooPoId     Int?
  odooPoName   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Customer {
  id                 Int                    @id @default(autoincrement())
  name               String
  code               String                 @unique
  shippingCostPerBF  Float                  @default(0)
  markupPercent      Float                  @default(0)
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  foamPricing        CustomerFoamPricing[]
  partNumberTemplate PartNumberTemplate?
  quotes             CushionQuote[]
}

model CustomerFoamPricing {
  id               Int      @id @default(autoincrement())
  customerId       Int
  foamId           Int
  overrideCostPerBF Float?
  overrideMarkup    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  foam             Foam     @relation(fields: [foamId], references: [id], onDelete: Cascade)

  @@unique([customerId, foamId])
}

model FoamInventory {
  id                Int      @id @default(autoincrement())
  foamId            Int      @unique
  boardFeetOnHand   Float    @default(0)
  lowStockThreshold Float    @default(100)
  lastUpdated       DateTime @default(now())
  foam              Foam     @relation(fields: [foamId], references: [id], onDelete: Cascade)
}

model DacronInventory {
  id                Int      @id @default(autoincrement())
  dacronId          Int      @unique
  sqFtOnHand        Float    @default(0)
  rollsOnHand       Int      @default(0)
  lowStockThreshold Float    @default(50)
  lastUpdated       DateTime @default(now())
  dacron            Dacron   @relation(fields: [dacronId], references: [id], onDelete: Cascade)
}

model LaborSettings {
  id                  Int      @id @default(1)
  defaultMakeTimeMin  Float    @default(30)
  avgHourlyRate       Float    @default(25)
  updatedAt           DateTime @updatedAt
}

model OverheadSettings {
  id                     Int      @id @default(1)
  facilityOverheadPercent Float   @default(15)
  indirectLaborPercent    Float   @default(10)
  defaultMarkupPercent    Float   @default(30)
  updatedAt              DateTime @updatedAt
}

model PartNumberTemplate {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique
  template   String   @default("{customer_code}-{foam_grade}-{L}x{W}x{H}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id         Int      @id @default(autoincrement())
  name       String
  ruleType   String   @default("manual")
  conditions Json
  actions    Json
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CushionQuote {
  id                 Int      @id @default(autoincrement())
  customerId         Int
  foamId             Int
  dacronId           Int?
  lengthIn           Float
  widthIn            Float
  heightIn           Float
  foamTolerancePct   Float    @default(0)
  dacronTolerancePct Float    @default(0)
  quantity           Int      @default(1)
  makeTimeMin        Float
  boardFeet          Float
  dacronSqFt         Float?
  materialCost       Float
  laborCost          Float
  overheadAmount     Float
  indirectLaborAmount Float
  subtotal           Float
  markupAmount       Float
  shippingCost       Float
  unitPrice          Float
  totalPrice         Float
  partNumber         String?
  status             String   @default("draft")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id])
  foam               Foam     @relation(fields: [foamId], references: [id])
  dacron             Dacron?  @relation(fields: [dacronId], references: [id])
}

model AiChatMessage {
  id        Int      @id @default(autoincrement())
  role      String
  content   String
  toolCalls Json?
  createdAt DateTime @default(now())
}
