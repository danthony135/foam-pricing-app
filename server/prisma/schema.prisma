generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local: file:./dev.db (see server/prisma/.env). Railway: file:/data/foam.db on a volume.
  url      = env("DATABASE_URL")
}

model Foam {
  id               Int                    @id @default(autoincrement())
  grade            String                 @unique
  density          Float
  ild              Float?
  costPerBoardFoot Float
  supplier         String?
  description      String?
  // Odoo link: product.template / product.product of the raw foam (UoM = BF)
  odooTemplateId   Int?                   @unique
  odooProductId    Int?
  thicknessIn      Float?                 // slab thickness parsed from the Odoo name (5" Foam → 5)
  sheetLengthIn    Float                  @default(82) // stock slab size the cut optimizer packs onto
  sheetWidthIn     Float                  @default(36)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  inventory        FoamInventory?
  pieces           FoamPiece[]
}

model Dacron {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  weightOz        Float
  thicknessInches Float
  costPerSqFt     Float
  supplier        String?
  description     String?
  odooTemplateId  Int?             @unique
  odooProductId   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventory       DacronInventory?
  pieces          FoamPiece[]
}

// ============================================================
// Odoo-synced manufactured SKUs and their foam patterns (the foam BOM)
// ============================================================

model Sku {
  id             Int         @id @default(autoincrement())
  odooTemplateId Int         @unique
  code           String      // model code, e.g. 400-30 or L400-30
  name           String      // full Odoo name
  shortName      String      @default("")
  collection     String      @default("")
  active         Boolean     @default(true)
  odooBomId      Int?
  odooFoamLines  Json?       // [{lineId, productId, templateId, name, qty, uom}] as last synced
  wastePct       Float?      // override of the global waste allowance
  notes          String?
  lastSyncedAt   DateTime?
  pushedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pieces         FoamPiece[]

  @@index([code])
  @@index([collection])
}

model FoamPiece {
  id         Int      @id @default(autoincrement())
  skuId      Int
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  name       String   // Seat core, Back core, Arm pad, Deck pad…
  foamId     Int?
  foam       Foam?    @relation(fields: [foamId], references: [id])
  lengthIn   Float    // bbox length (x) — for shaped pieces derived from the outline
  widthIn    Float    // bbox width (y)
  heightIn   Float    // thickness
  shapeType  String   @default("rect") // rect | polygon
  shape      Json?    // polygon outline [[x,y],…] in inches, y-down, normalized to (0,0)
  areaSqIn   Float?   // true area of the outline (rect: L×W)
  shapeSource String? // preset:t-cushion | dxf | photo | drawn
  qty        Int      @default(1)
  dacronId   Int?
  dacron     Dacron?  @relation(fields: [dacronId], references: [id])
  wrapDacron Boolean  @default(false)
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([skuId])
}

// A production run's foam requirement: from Odoo MOs or typed SKU × qty.
model FoamOrder {
  id           Int      @id @default(autoincrement())
  name         String
  status       String   @default("draft") // draft | optimized | ordered | cut | done
  source       String   @default("manual") // manual | mo | schedule
  scheduleNumber String? @unique // FurnitureSuite production list (mrp.production.x_schedule_number)
  cutProgress  Json?    // {done: ["<foamId>-<slabIndex>", …], updatedAt}
  lines        Json     // [{skuId, code, name, qty, moName?, moId?}]
  requirements Json?    // per foam: pieces, boardFeet, withWaste, onHand, shortfall
  cutPlan      Json?    // per foam: sheets[] with placed rectangles
  odooPoId     Int?
  odooPoName   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Scrap per slab type, logged when a cut list is finished (all slabs ticked).
model ScrapLog {
  id             Int      @id @default(autoincrement())
  foamOrderId    Int
  foamId         Int
  grade          String
  scheduleNumber String?
  slabs          Int
  slabSqIn       Float    // one slab's area
  usedSqIn       Float
  scrapSqIn      Float
  scrapBF        Float    // scrap × thickness / 144
  usedBF         Float
  gluedPieces    Int      @default(0)
  remnants       Json?    // largest free rectangles per slab [{slab, w, h}]
  createdAt      DateTime @default(now())

  @@unique([foamOrderId, foamId])
  @@index([foamId, createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}



model FoamInventory {
  id                Int      @id @default(autoincrement())
  foamId            Int      @unique
  boardFeetOnHand   Float    @default(0)
  lowStockThreshold Float    @default(100)
  lastUpdated       DateTime @default(now())
  foam              Foam     @relation(fields: [foamId], references: [id], onDelete: Cascade)
}

model DacronInventory {
  id                Int      @id @default(autoincrement())
  dacronId          Int      @unique
  sqFtOnHand        Float    @default(0)
  rollsOnHand       Int      @default(0)
  lowStockThreshold Float    @default(50)
  lastUpdated       DateTime @default(now())
  dacron            Dacron   @relation(fields: [dacronId], references: [id], onDelete: Cascade)
}






